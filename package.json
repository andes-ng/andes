    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "verdaccio": "^6.10.6",
    "vite": "^8.3.5",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@andes-ng/testing": "workspace:*",
    "@andes-ng/tokens": "workspace:*",
    "@andes-ng/ui": "workspace:*",
    "@angular/cdk": "~22.2.4",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
