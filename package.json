{
  "name": "@andes-ng/workspace",
  "version": "0.0.0",
  "description": "Open-source Angular design system for enterprise applications.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:storybook": "nx build-storybook ui",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "playground": "nx serve playground",
    "release:changelog": "nx release changelog",
    "release:publish": "nx release publish",
    "release:version": "nx release version",
    "release:prepare": ".github/scripts/release-prepare.sh",
    "storybook": "nx storybook ui",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.3",
    "@angular-devkit/schematics": "~22.2.3",
    "@angular/build": "~22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@nx/angular": "23.3.1",
    "@nx/devkit": "23.3.1",
    "@nx/eslint": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/storybook": "23.3.1",
    "@nx/vitest": "23.3.1",
    "@nx/web": "23.3.1",
    "@schematics/angular": "~22.2.3",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/angular": "^10.6.3",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.72.0",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "^22.6.0",
    "clsx": "^2.1.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^30.1.3",
